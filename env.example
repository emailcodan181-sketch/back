# ── BANCO DE DADOS ─────────────────────────────────────────────────
# Dev local (SQLite):
DB_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"
# Produção (PostgreSQL no Neon — descomentar ao fazer deploy):
# DB_PROVIDER=postgresql
# DATABASE_URL="postgresql://user:pass@host.neon.tech/valvet?sslmode=require"

# ── JWT ────────────────────────────────────────────────────────────
# Gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── IA ─────────────────────────────────────────────────────────────
AI_API_KEY=
AI_MODEL=claude-sonnet-4-20250514
AI_BASE_URL=https://api.anthropic.com/v1

# ── ADMINISTRAÇÃO ──────────────────────────────────────────────────
ADMIN_USER_ID=

# ── AMBIENTE ───────────────────────────────────────────────────────
NODE_ENV=development

# ── CORS ───────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173

# ── COOKIES ────────────────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# ── PORTA ──────────────────────────────────────────────────────────
PORT=4000
